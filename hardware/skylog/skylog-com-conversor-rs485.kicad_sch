(property "Description" "Módulo pronto RS485 / TTL V2 de Virendra K; direção automática. CN1: TXD entrada, RXD saída, GND, +5V. CN2: B, A, GND. Geometria da PCB original; validar montagem." (at 0 0 0) (hide yes) (effects (font (size 1.27 1.27))))
(property "Pinagem" "CN1.1 TXD entrada; CN1.2 RXD saída; CN1.3 GND; CN1.4 +5V; CN2.1 B; CN2.2 A; CN2.3 GND" (at 0 0 0) (hide yes) (effects (font (size 1.27 1.27))))
(property "Montagem" "JST 2,50 mm no original. Footprint reproduz ilhas da placa do módulo, não o encaixe dos JST. Usar cabos com conectores compatíveis ou preparar terminais voltados para a placa-base e validar mecanicamente." (at 0 0 0) (hide yes) (effects (font (size 1.27 1.27))))
(property "Validacao_eletrica" "Original: valor U2 SN75176BDR, MPN SN75HVD08D, alimentação interna 3,3V. Confirmar CI instalado e níveis lógicos; ver conversor-rs485.md." (at 0 0 0) (hide yes) (effects (font (size 1.27 1.27))))
(property "Controle_direcao" "Automático; sem pinos DE/RE externos. No firmware Skylog, PINO_DE = -1." (at 0 0 0) (hide yes) (effects (font (size 1.27 1.27))))
(property "ki_keywords" "RS485 TTL UART automatic module JST 2.50 Virendra" (at 0 0 0) (hide yes) (effects (font (size 1.27 1.27))))
(property "ki_fp_filters" "RS485_TTL_V2_OSHWLab*" (at 0 0 0) (hide yes) (effects (font (size 1.27 1.27))))
